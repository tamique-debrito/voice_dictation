{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "annotations",
  "type": "object",
  "required": ["session_id", "source_chunks", "annotations"],
  "properties": {
    "session_id": {"type": "string"},
    "source_chunks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "annotations": {
      "type": "array",
      "items": {"$ref": "#/definitions/Annotation"}
    }
  },
  "definitions": {
    "Annotation": {
      "type": "object",
      "required": ["index", "type", "raw_span"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "type": {"type": "string"},
        "raw_span": {"type": "string"},
        "context_before": {"type": "string"},
        "context_after": {"type": "string"},
        "corrected_span": {"type": "string"},
        "transcription_corrections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["original", "corrected"],
            "properties": {
              "original": {"type": "string"},
              "corrected": {"type": "string"},
              "reason": {"type": "string"}
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "trigger": {"type": "string"},
        "expected_action": {"type": "string"},
        "expected_inputs": {"type": "string"},
        "expected_outputs": {"type": "string"},
        "success_criteria": {"type": "string"},
        "summary": {"type": "string"},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
